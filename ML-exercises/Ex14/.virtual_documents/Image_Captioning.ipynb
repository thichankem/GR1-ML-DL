import pandas as pd

def make_data(txt_path = 'flickr8k/captions.txt'):
    img_names = []
    captions = []
    df=pd.read_csv(txt_path)

    img_names=df['image'].tolist()
    captions=df['caption'].tolist()
    return img_names,captions


def split_data(img_paths,targets):
    img_names_train, img_names_temp, captions_train, captions_temp=model_selection.train_test_split(img_paths, targets, test_size=0.2, random_state=42)
    img_names_test, img_names_val, captions_test, captions_val=model_selection.train_test_split(img_names_temp, captions_temp, test_size=0.5, random_state=42)
    return img_names_train,captions_train,img_names_val,captions_val,img_names_test,captions_test


def write_json(data,data_path):
    with open(data_path, 'w') as f:
        json.dump(data, f)


def read_json(data_path):
    with open(data_path, 'r') as f:
        return json.load(f)


class Vocab:

    def __init__(self,captions,freq_threshold):
        self.captions = captions
        self.freq_threshold = freq_threshold
        self.itos = {0: "<PAD>", 1: "<SOS>", 2: "<EOS>", 3: "<UNK>"}
        self.stoi = {"<PAD>": 0, "<SOS>": 1, "<EOS>": 2, "<UNK>": 3}

    def get_vocab(self):
        word2fre ={}
        idx = 4 # >3!
        self.max_length = 0
        for caption in self.captions:
            for i,word in enumerate(tokenizer_eng(caption)):
                if word not in word2fre:
                    word2fre[word] = 1
                else:
                    word2fre[word]+=1
                if word2fre[word] == self.freq_threshold:
                    self.stoi[word] = idx
                    self.itos[idx] = word
                    idx += 1

            if i + 1 > self.max_length:
                self.max_length = i + 1


def tokenizer_eng(text):
    return [tok.text.lower() for tok in spacy_eng.tokenizer(text)]# token text sử dụng spacy_eng.tokenizer


def numericalize(text,stoi):
    tokenized_text = tokenizer_eng(text)

    return [
        stoi[token] if token in stoi else stoi["<UNK>"]
        for token in tokenized_text
    ]


def clip_gradient(optimizer, grad_clip):
    for group in optimizer.param_groups:
        for param in group['params']:
            if param.grad is not None:
                param.grad.data.clamp_(-grad_clip, grad_clip)


def save_checkpoint(epoch, encoder, decoder, encoder_optimizer, decoder_optimizer,model_save_path='flickr8k/model.pth'):
  
    state = {'epoch': epoch,       
             'encoder': encoder,
             'decoder': decoder,
             'encoder_optimizer': encoder_optimizer,
             'decoder_optimizer': decoder_optimizer}
    filename = model_save_path + '.tar'
    torch.save(state, filename)
   



